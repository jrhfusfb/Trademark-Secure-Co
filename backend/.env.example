# Copy this file to .env and fill in your values

# IMPORTANT for Vercel: MONGO_URI must be a MongoDB Atlas cloud URI (not localhost)
# Get a free cluster at https://www.mongodb.com/atlas
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/trademark_secure?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/trademark_secure

# Optional: SheetMonkey URL for syncing leads to Google Sheets
SHEETMONKEY_URL=https://api.sheetmonkey.io/form/your-form-id
